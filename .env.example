
# =============================================
# Aplicación
# =============================================

# Opcional: URL pública del frontend, solo si se necesitan URLs absolutas.
APP_BASE_URL=http://localhost:3000

# =============================================
# Backend externo
# =============================================

# Obligatorio para el BFF de Next.js.
# Puede apuntar a localhost o a un servidor remoto.
BACKEND_API_URL=http://localhost:5000/api/v1

# =============================================
# Sesión
# =============================================

# Deben coincidir con los nombres definidos
# por el backend en Set-Cookie.
AUTH_ACCESS_COOKIE_NAME=accessToken

# Verificación JWT - HS256
JWT_ACCESS_SECRET=REEMPLAZAR_POR_SECRETO_SEGURO

# =============================================
# JWT
# =============================================

# Opcionales, si NestJS los define
# JWT_ISSUER=
# JWT_AUDIENCE=

DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=una-cadena-aleatoria-de-al-menos-32-bytes-para-dev
